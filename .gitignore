# Data artifacts (do not track raw or processed data directly in git, use DVC)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Ensure DVC tracking files are NOT ignored
!*.dvc
!.dvc/

# Model artifacts
models/*
!models/.gitkeep

# MLflow experiment tracking
mlruns/
mlartifacts/
mlflow.db
*.db

# Testing and reports
.pytest_cache/
.coverage
htmlcov/
reports/*
!reports/.gitkeep
!reports/data_card.md
!reports/data_validation_report.json
!reports/model_comparison.json
!reports/model_card.md
!reports/evaluation_report.json
!reports/quality_gate_report.json
!reports/figures/
!reports/figures/**

