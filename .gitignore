# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
*.env

# Data artifacts (do not track raw or processed data directly in git, use DVC)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Ensure DVC tracking files are NOT ignored
!*.dvc
!.dvc/

# Model artifacts
models/*
!models/.gitkeep

# Testing and reports
.pytest_cache/
.coverage
htmlcov/
reports/*
!reports/.gitkeep

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
